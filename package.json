{
  "name": "zara-challenge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=18.18.0 <19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "warm-up": "node scripts/warm-up.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:contract": "playwright test -c playwright.contract.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml}": "prettier --write"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^18.19.130",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vitest-axe": "0.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28",
      "sharp": "^0.34.5",
      "test-exclude": "7.0.1",
      "@typescript-eslint/eslint-plugin": "8.55.0",
      "@typescript-eslint/parser": "8.55.0",
      "typescript-eslint": "8.55.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
